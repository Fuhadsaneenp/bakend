NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_saas?schema=public
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HR Platform <no-reply@example.com>"
RESEND_API_KEY=
RESEND_FROM="Second Tales EMS <onboarding@resend.dev>"
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
BIOMETRIC_API_KEY=essl-secret-key-123
ALLOWED_BIOMETRIC_SNS=TEST123,x2008_sn

# SEO: backend-only Google OAuth and encrypted token storage.
# Register this callback with the Google OAuth web application.
SEO_GOOGLE_CLIENT_ID=
SEO_GOOGLE_CLIENT_SECRET=
SEO_GOOGLE_REDIRECT_URI=https://api.secondtales.com/api/seo/google/callback
# Generate 32 random bytes as 64 hex characters; keep this key in your secret manager.
SEO_TOKEN_KEY=
# Enable only after applying the SEO migration and validating a real client sync.
SEO_JOBS_ENABLED=false
