generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum AccessScopeType {
  GLOBAL
  COMPANY
  SELF
  DIRECT_REPORTS
  DEPARTMENT
  TEAM
  OFFICE
  CLIENT
  PROJECT
  ASSIGNED_CLIENTS
  ASSIGNED_PROJECTS
  ASSIGNED_TO_ME
  CREATED_BY_ME
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
  ESCALATED
  COMMENTED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  TRAVEL
  FOOD
  OFFICE
  MEDICAL
}

enum ReimbursementStatus {
  NOT_READY
  READY
  PAID
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LetterType {
  OFFER
  EXPERIENCE
  RELIEVING
  CONFIRMATION
  CUSTOM
}

model Company {
  id          String       @id @default(cuid())
  name        String
  legalName   String?
  logoUrl     String?
  phoneCode   String?
  phone       String?
  email       String?
  overview    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  departments Department[]
  employees   Employee[]
  payrollRuns PayrollRun[]
  clients     Client[]
  workCards   WorkCard[]
  shifts      Shift[]
  offices     Office[]
  settings    CompanySetting[]
  worksSevenDays Boolean      @default(false)
  appraisalCycles AppraisalCycle[]
  appraisals      Appraisal[]
  lifecycleTemplates LifecycleTemplate[]
  jobOpenings         JobOpening[]
  jobApplicants       JobApplicant[]
  accessProfiles      AccessProfile[]
  approvalWorkflows   ApprovalWorkflow[]
  authorityAuditLogs  AuthorityAuditLog[]
  teams               Team[]
  metaAdAccounts      MetaAdAccount[]
  metaCampaigns       MetaCampaign[]
  metaLeads           MetaLead[]
}

model CompanySetting {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}

model Office {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  placeName   String?
  country     String
  isHQ        Boolean  @default(false)
  active      Boolean  @default(true)
  timezone    String
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model User {
  id              String       @id @default(cuid())
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id])
  email           String       @unique
  passwordHash    String
  role            Role
  refreshHash     String?
  isActive        Boolean      @default(true)
  employee        Employee?
  notifications   Notification[]
  auditLogs       AuditLog[]   @relation("ActorAuditLogs")
  statusHistories StatusHistory[]
  comments        Comment[]
  assignedAccessProfiles        UserAccessProfile[]        @relation("UserAssignedAccessProfiles")
  accessProfilesAssignedBy      UserAccessProfile[]        @relation("AccessProfileAssignmentsMade")
  permissionOverrides           UserPermissionOverride[]   @relation("UserPermissionOverrides")
  permissionOverridesAssignedBy UserPermissionOverride[]   @relation("PermissionOverridesAssignedBy")
  userPermissionScopes          UserPermissionScope[]      @relation("UserPermissionScopes")
  userPermissionScopesAssignedBy UserPermissionScope[]     @relation("PermissionScopesAssignedBy")
  approvalActions               ApprovalActionLog[]
  authorityChangesMade          AuthorityAuditLog[]        @relation("AuthorityChangesMade")
  authorityChangesReceived      AuthorityAuditLog[]        @relation("AuthorityChangesReceived")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Department {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  name        String
  code        String
  employees   Employee[]
  designations Designation[]
  jobOpenings JobOpening[]
  teams       Team[]
  @@unique([companyId, code])
}

model Designation {
  id           String      @id @default(cuid())
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  title        String
  employees    Employee[]
}

model Employee {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  managerId      String?
  manager        Employee?       @relation("ManagerReports", fields: [managerId], references: [id])
  reports        Employee[]      @relation("ManagerReports")
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id])
  designationId  String?
  designation    Designation?    @relation(fields: [designationId], references: [id])
  employeeCode   String
  biometricId    String?         @unique
  firstName      String
  middleName     String?
  lastName       String
  displayName    String?
  phone          String?
  personalEmail  String?
  dateOfBirth    DateTime?
  gender         String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankName       String?
  bankAccountNumber String?
  bankIfsc       String?
  taxId          String?
  dateOfJoining  DateTime
  status         EmployeeStatus  @default(ACTIVE)
  dateOfExit       DateTime?
  exitReason       String?
  exitRemarks      String?
  settlementStatus String?         @default("PENDING")
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  baseCurrency   String          @default("INR")
  salary         Salary?
  shiftId        String?
  shift          Shift?          @relation(fields: [shiftId], references: [id])
  officeId       String?
  isHrHead       Boolean         @default(false)
  customAttendanceHoursEnabled Boolean @default(false)
  customFullDayHours Decimal?      @db.Decimal(4, 2)
  customHalfDayHours Decimal?      @db.Decimal(4, 2)
  documents      EmployeeDocument[]
  letters        EmployeeLetter[]
  attendance     Attendance[]
  wfhRequests    WFHRequest[]
  expenseClaims  ExpenseClaim[]
  payslips       Payslip[]
  assignedWorkCards WorkCard[] @relation("AssignedWorkCards")
  createdWorkCards  WorkCard[] @relation("CreatedWorkCards")
  reworkCharged     ReworkLog[] @relation("ReworkCharged")
  pointsLedgers     PointsLedger[]
  ratingsGiven      Rating[] @relation("RatingsGiven")
  managedClients    Client[] @relation("ManagedClients")
  kras              KRA[]
  goals             Goal[]
  appraisals        Appraisal[]
  approvedAppraisals Appraisal[] @relation("AppraisalApprover")
  checklists        EmployeeChecklist[]
  completedChecklistItems EmployeeChecklistItem[] @relation("TaskCompletedBy")
  advances          EmployeeAdvance[]
  leaveAllocations  LeaveAllocation[]
  managedJobOpenings JobOpening[] @relation("HiringManagerJobOpenings")
  teamMemberships   TeamMember[]
  ledTeams          Team[]
  assignedMetaCampaigns MetaCampaign[] @relation("AssignedMetaCampaigns")
  assignedMetaLeads     MetaLead[]     @relation("AssignedMetaLeads")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@unique([companyId, employeeCode])
}

model Salary {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id])
  basic       Decimal  @db.Decimal(12, 2)
  allowances  Decimal  @db.Decimal(12, 2)
  deductions  Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  createdAt   DateTime @default(now())
}

model EmployeeDocument {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String
  status      String   @default("UPLOADED")
  fileKey     String
  fileName    String
  mimeType    String
  fileData    Bytes?
  storedInDatabase Boolean @default(false)
  uploadedBy  String?
  verifiedAt  DateTime?
  verifiedBy  String?
  notes       String?
  uploadedAt  DateTime @default(now())
}

model EmployeeLetter {
  id          String     @id @default(cuid())
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id])
  type        LetterType
  title       String
  body        String     @db.Text
  fileKey     String?
  fileData    Bytes?
  storedInDatabase Boolean @default(false)
  generatedBy String?
  issuedAt    DateTime   @default(now())
  createdAt   DateTime   @default(now())
}

model PayrollRun {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  month       Int
  year        Int
  processedBy String
  status      String    @default("PROCESSED")
  type        String    @default("REGULAR")
  grossTotal  Decimal   @db.Decimal(14, 2)
  netTotal    Decimal   @db.Decimal(14, 2)
  payslips    Payslip[]
  createdAt   DateTime  @default(now())
  @@unique([companyId, month, year, type])
}

model Payslip {
  id             String     @id @default(cuid())
  payrollRunId   String
  payrollRun     PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id])
  payslipNumber  String     @unique
  month          Int
  year           Int
  basic          Decimal    @db.Decimal(12, 2)
  allowances     Decimal    @db.Decimal(12, 2)
  deductions     Decimal    @db.Decimal(12, 2)
  gratuity       Decimal    @default(0.00) @db.Decimal(12, 2)
  leaveEncashment Decimal   @default(0.00) @db.Decimal(12, 2)
  noticePay      Decimal    @default(0.00) @db.Decimal(12, 2)
  attendanceDays Decimal    @db.Decimal(5, 2)
  payableDays    Decimal    @db.Decimal(5, 2)
  grossPay       Decimal    @db.Decimal(12, 2)
  netPay         Decimal    @db.Decimal(12, 2)
  pdfKey         String?
  sentAt         DateTime?
  createdAt      DateTime   @default(now())
  @@unique([employeeId, month, year])
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  workDate    DateTime
  checkInAt   DateTime?
  checkOutAt  DateTime?
  workMinutes Int       @default(0)
  overtimeMinutes Int   @default(0)
  isLate      Boolean   @default(false)
  isEarlyLeave Boolean  @default(false)
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  @@unique([employeeId, workDate])
}

model WFHRequest {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  reason      String
  immediateManagerId         String?
  higherManagerId            String?
  immediateManagerStatus     ApprovalStatus @default(PENDING)
  immediateManagerReviewedBy String?
  immediateManagerReviewedAt DateTime?
  higherManagerStatus        ApprovalStatus @default(PENDING)
  higherManagerReviewedBy    String?
  higherManagerReviewedAt    DateTime?
  hrHeadStatus               ApprovalStatus @default(PENDING)
  hrHeadReviewedBy           String?
  hrHeadReviewedAt           DateTime?
  status      ApprovalStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime       @default(now())
}

model ExpenseClaim {
  id          String              @id @default(cuid())
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id])
  category    ExpenseCategory
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("INR")
  description String
  receiptKey  String?
  managerStatus ApprovalStatus    @default(PENDING)
  hrStatus    ApprovalStatus      @default(PENDING)
  reimbursementStatus ReimbursementStatus @default(NOT_READY)
  advanceId   String?
  advance     EmployeeAdvance? @relation(fields: [advanceId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Notification {
  id          String              @id @default(cuid())
  userId      String?
  user        User?               @relation(fields: [userId], references: [id])
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  subject     String
  body        String
  metadata    Json?
  createdAt   DateTime            @default(now())
  sentAt      DateTime?
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  action      String
  entity      String
  entityId    String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model Permission {
  id                     String                    @id @default(cuid())
  code                   String                    @unique
  module                 String
  feature                String
  action                 String
  description            String                    @db.Text
  isSensitive            Boolean                   @default(false)
  accessProfilePermissions AccessProfilePermission[]
  userPermissionOverrides UserPermissionOverride[]
  profilePermissionScopes ProfilePermissionScope[]
  userPermissionScopes    UserPermissionScope[]
  approvalWorkflowStages  ApprovalWorkflowStage[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
}

model AccessProfile {
  id              String                    @id @default(cuid())
  companyId       String?
  company         Company?                  @relation(fields: [companyId], references: [id])
  code            String
  name            String
  description     String?                   @db.Text
  category        String?
  isSystem        Boolean                   @default(false)
  isActive        Boolean                   @default(true)
  permissions     AccessProfilePermission[]
  userAssignments UserAccessProfile[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([companyId, code])
}

model AccessProfilePermission {
  id               String           @id @default(cuid())
  accessProfileId  String
  accessProfile    AccessProfile    @relation(fields: [accessProfileId], references: [id])
  permissionId     String
  permission       Permission       @relation(fields: [permissionId], references: [id])
  effect           PermissionEffect @default(ALLOW)
  scopes           ProfilePermissionScope[]
  createdAt        DateTime         @default(now())

  @@unique([accessProfileId, permissionId])
}

model UserAccessProfile {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation("UserAssignedAccessProfiles", fields: [userId], references: [id])
  accessProfileId String
  accessProfile   AccessProfile @relation(fields: [accessProfileId], references: [id])
  assignedById    String?
  assignedBy      User?         @relation("AccessProfileAssignmentsMade", fields: [assignedById], references: [id])
  assignedAt      DateTime      @default(now())
  expiresAt       DateTime?
  isActive        Boolean       @default(true)

  @@index([userId, isActive])
}

model UserPermissionOverride {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation("UserPermissionOverrides", fields: [userId], references: [id])
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id])
  effect       PermissionEffect @default(ALLOW)
  reason       String?          @db.Text
  expiresAt    DateTime?
  assignedById String?
  assignedBy   User?            @relation("PermissionOverridesAssignedBy", fields: [assignedById], references: [id])
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId, isActive])
}

model AccessScope {
  id          String          @id @default(cuid())
  code        AccessScopeType @unique
  name        String
  description String          @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProfilePermissionScope {
  id                        String                  @id @default(cuid())
  accessProfilePermissionId String
  accessProfilePermission   AccessProfilePermission @relation(fields: [accessProfilePermissionId], references: [id])
  permissionId              String
  permission                Permission              @relation(fields: [permissionId], references: [id])
  scopeType                 AccessScopeType
  scopeRefId                String?
  createdAt                 DateTime                @default(now())

  @@index([accessProfilePermissionId, scopeType])
}

model UserPermissionScope {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("UserPermissionScopes", fields: [userId], references: [id])
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id])
  scopeType    AccessScopeType
  scopeRefId   String?
  assignedById String?
  assignedBy   User?           @relation("PermissionScopesAssignedBy", fields: [assignedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([userId, permissionId, scopeType])
}

model Team {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  leadEmployeeId String?
  leadEmployee   Employee?    @relation(fields: [leadEmployeeId], references: [id])
  code           String?
  name           String
  isActive       Boolean      @default(true)
  members        TeamMember[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyId, name])
}

model TeamMember {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([teamId, employeeId])
}

model ApprovalWorkflow {
  id          String                  @id @default(cuid())
  companyId   String?
  company     Company?                @relation(fields: [companyId], references: [id])
  code        String
  name        String
  module      String
  feature     String
  description String?                 @db.Text
  isActive    Boolean                 @default(true)
  stages      ApprovalWorkflowStage[]
  actions     ApprovalActionLog[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([companyId, code])
}

model ApprovalWorkflowStage {
  id                   String             @id @default(cuid())
  workflowId           String
  workflow             ApprovalWorkflow   @relation(fields: [workflowId], references: [id])
  stageOrder           Int
  stageName            String
  requiredPermissionId String?
  requiredPermission   Permission?        @relation(fields: [requiredPermissionId], references: [id])
  approverScopeType    AccessScopeType    @default(GLOBAL)
  approverScopeRefId   String?
  escalationHours      Int?
  finalStatus          String?
  isFinal              Boolean            @default(false)
  canReturn            Boolean            @default(true)
  canReject            Boolean            @default(true)
  actionLogs           ApprovalActionLog[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([workflowId, stageOrder])
}

model ApprovalActionLog {
  id          String               @id @default(cuid())
  workflowId  String
  workflow    ApprovalWorkflow     @relation(fields: [workflowId], references: [id])
  stageId     String?
  stage       ApprovalWorkflowStage? @relation(fields: [stageId], references: [id])
  entityType  String
  entityId    String
  actorUserId String?
  actorUser   User?                @relation(fields: [actorUserId], references: [id])
  decision    ApprovalDecision
  comments    String?              @db.Text
  previousStatus String?
  newStatus   String?
  createdAt   DateTime             @default(now())

  @@index([entityType, entityId])
}

model AuthorityAuditLog {
  id           String    @id @default(cuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  actorUserId  String?
  actorUser    User?     @relation("AuthorityChangesMade", fields: [actorUserId], references: [id])
  targetUserId String?
  targetUser   User?     @relation("AuthorityChangesReceived", fields: [targetUserId], references: [id])
  action       String
  entityType   String
  entityId     String?
  oldValue     Json?
  newValue     Json?
  reason       String?   @db.Text
  createdAt    DateTime  @default(now())
}

model Client {
  id                         String       @id @default(cuid())
  companyId                  String
  company                    Company      @relation(fields: [companyId], references: [id])
  name                       String
  details                    String?      @db.Text
  contacts                   String?      @db.Text
  packageName                String?
  postersCommitted           Int?
  videoSeo                   String?
  digitalMarketingActivities String?      @db.Text
  accountManagerId           String?
  accountManager             Employee?    @relation("ManagedClients", fields: [accountManagerId], references: [id])
  specialDays                SpecialDay[]
  workCards                  WorkCard[]
  metaAdAccount              MetaAdAccount?
  metaCampaigns              MetaCampaign[]
  metaLeads                  MetaLead[]
  metaDailyInsights          MetaDailyInsight[]
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
}

model SpecialDay {
  id        String   @id @default(cuid())
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  title     String
  type      String   // FESTIVAL, BIRTHDAY, ANNIVERSARY, CAMPAIGN
  date      DateTime
  createdAt DateTime @default(now())
}

model WorkCard {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  workId        String          @unique
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id])
  title         String
  brief         String          @db.Text
  category      String
  priority      String          // URGENT, HIGH, NORMAL, LOW
  complexity    String          // SIMPLE, MEDIUM, HEAVY
  deadline      DateTime
  assignedToId  String?
  assignedTo    Employee?       @relation("AssignedWorkCards", fields: [assignedToId], references: [id])
  assignedById  String?
  assignedBy    Employee?       @relation("CreatedWorkCards", fields: [assignedById], references: [id])
  status        String          // PENDING, IN_PROGRESS, FINISHED, OUT_TO_DELIVER, APPROVED, REWORK
  reworkCount   Int             @default(0)
  files         String?         @db.LongText // JSON string with base64 deliverable previews
  pointsEarned  Float?          @default(0)
  ratings       Rating[]
  statusHistory StatusHistory[]
  comments      Comment[]
  reworkLogs    ReworkLog[]
  pointsLedgers PointsLedger[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model StatusHistory {
  id         String   @id @default(cuid())
  workCardId String
  workCard   WorkCard @relation(fields: [workCardId], references: [id])
  status     String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model ReworkLog {
  id          String   @id @default(cuid())
  workCardId  String
  workCard    WorkCard @relation(fields: [workCardId], references: [id])
  roundNumber Int
  reason      String
  comment     String?  @db.Text
  chargedToId String?
  chargedTo   Employee? @relation("ReworkCharged", fields: [chargedToId], references: [id])
  createdAt   DateTime @default(now())
}

model PointsLedger {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  workCardId  String?
  workCard    WorkCard? @relation(fields: [workCardId], references: [id])
  points      Float
  description String
  createdAt   DateTime  @default(now())
}

model Rating {
  id         String   @id @default(cuid())
  workCardId String
  workCard   WorkCard @relation(fields: [workCardId], references: [id])
  rating     Int
  feedback   String?  @db.Text
  ratedById  String?
  ratedBy    Employee? @relation("RatingsGiven", fields: [ratedById], references: [id])
  createdAt  DateTime @default(now())
}

model Comment {
  id         String   @id @default(cuid())
  workCardId String
  workCard   WorkCard @relation(fields: [workCardId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  text       String   @db.Text
  createdAt  DateTime @default(now())
}

model WorkTrackSetting {
  id             String @id @default("settings")
  companyId      String @unique
  pointValues    String @db.Text // JSON string
  slaTimes       String @db.Text // JSON string
  categories     String @db.Text // JSON string
  reworkReasons  String @db.Text // JSON string
  promotionRules String @db.Text // JSON string
}

model BiometricRawLog {
  id                 String   @id @default(cuid())
  deviceSerialNumber String
  requestMethod      String
  requestPath        String
  queryParameters    String   @db.Text
  headers            String   @db.Text
  rawPayload         String   @db.Text
  receivedAt         DateTime @default(now())
  processingStatus   String   @default("PENDING") // PENDING, PROCESSED, FAILED
  errorMessage       String?  @db.Text
}

model Shift {
  id                  String     @id @default(cuid())
  companyId           String
  company             Company    @relation(fields: [companyId], references: [id])
  name                String
  startTime           String     // e.g. "09:00"
  endTime             String     // e.g. "18:00"
  gracePeriod         Int        @default(15) // minutes
  earlyPunchTolerance Int        @default(15) // minutes
  workMinutesFix      Int        @default(480) // minutes
  workingDays         String     @db.Text // JSON array of active weekday names
  effectiveFrom       DateTime   @default(now())
  scheduleType        String     @default("Clock-based")
  isDefault           Boolean    @default(false)
  isActive            Boolean    @default(true)
  employees           Employee[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([companyId, name])
}

model AppraisalCycle {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  title       String
  startDate   DateTime
  endDate     DateTime
  status      String      @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  appraisals  Appraisal[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model KRA {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  title       String
  weightage   Float       // percentage (e.g. 20.0)
  description String?     @db.Text
  goals       Goal[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Goal {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id])
  kraId       String?
  kra         KRA?        @relation(fields: [kraId], references: [id])
  title       String
  description String?     @db.Text
  startDate   DateTime
  endDate     DateTime
  target      Float       @default(100.0)
  achieved    Float       @default(0.0)
  status      String      @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, ARCHIVED
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Appraisal {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  employeeId       String
  employee         Employee       @relation(fields: [employeeId], references: [id])
  appraisalCycleId String
  appraisalCycle   AppraisalCycle @relation(fields: [appraisalCycleId], references: [id])
  status           String         @default("DRAFT") // DRAFT, SUBMITTED, REVIEWED, APPROVED
  selfScore        Float?
  managerScore     Float?
  finalScore       Float?
  selfFeedback     String?        @db.Text
  managerFeedback  String?        @db.Text
  approvedById     String?
  approvedBy       Employee?      @relation("AppraisalApprover", fields: [approvedById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model LifecycleTemplate {
  id          String                  @id @default(cuid())
  companyId   String
  company     Company                 @relation(fields: [companyId], references: [id])
  title       String
  type        String                  // ONBOARDING, EXIT
  tasks       LifecycleTemplateTask[]
  checklists  EmployeeChecklist[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model LifecycleTemplateTask {
  id          String            @id @default(cuid())
  templateId  String
  template    LifecycleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  description String?           @db.Text
  assignedRole String            @default("HR") // HR, IT, FINANCE, MANAGER
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model EmployeeChecklist {
  id          String                @id @default(cuid())
  employeeId  String
  employee    Employee              @relation(fields: [employeeId], references: [id])
  templateId  String
  template    LifecycleTemplate     @relation(fields: [templateId], references: [id])
  type        String                // ONBOARDING, EXIT
  status      String                @default("PENDING") // PENDING, COMPLETED
  items       EmployeeChecklistItem[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model EmployeeChecklistItem {
  id          String            @id @default(cuid())
  checklistId String
  checklist   EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  description String?           @db.Text
  assignedRole String
  status      String            @default("PENDING") // PENDING, COMPLETED
  completedAt DateTime?
  completedById String?
  completedBy Employee?         @relation("TaskCompletedBy", fields: [completedById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model EmployeeAdvance {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  purpose         String
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR")
  status          String         @default("PENDING") // PENDING, APPROVED, REJECTED, PAID, SETTLED
  managerStatus   ApprovalStatus @default(PENDING)
  hrStatus        ApprovalStatus @default(PENDING)
  claimedAmount   Decimal        @default(0.00) @db.Decimal(12, 2)
  expenseClaims   ExpenseClaim[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LeaveAllocation {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  leaveType   String   // e.g. "Casual Leave", "Sick Leave"
  year        Int      // e.g. 2026
  maxDays     Decimal  @db.Decimal(5, 2)
  usedDays    Decimal  @default(0.00) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, leaveType, year])
}

model JobOpening {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  departmentId     String?
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hiringManagerId  String?
  hiringManager    Employee?     @relation("HiringManagerJobOpenings", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  title            String
  employmentType   String        @default("FULL_TIME")
  location         String?
  openings         Int           @default(1)
  status           String        @default("DRAFT") // DRAFT, OPEN, ON_HOLD, CLOSED
  priority         String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  description      String?       @db.Text
  targetDate       DateTime?
  applicants       JobApplicant[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId, status])
}

model JobApplicant {
  id                   String      @id @default(cuid())
  companyId            String
  company              Company     @relation(fields: [companyId], references: [id])
  jobOpeningId         String
  jobOpening           JobOpening  @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  fullName             String
  email                String
  phone                String?
  stage                String      @default("APPLIED") // APPLIED, SCREENING, INTERVIEW, OFFER, HIRED, REJECTED, ON_HOLD
  source               String?
  currentCompany       String?
  experienceYears      Float?
  rating               Float?
  noticePeriodDays     Int?
  expectedCompensation Decimal?    @db.Decimal(12, 2)
  summary              String?     @db.Text
  appliedAt            DateTime    @default(now())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([companyId, stage])
  @@index([jobOpeningId, stage])
}

model MetaAdAccount {
  id                  String    @id @default(cuid())
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  clientId            String    @unique
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessManagerId   String?
  adAccountId         String?
  pageId              String?
  instagramAccountId  String?
  pixelId             String?
  accessToken         String?   @db.Text
  tokenStatus         String    @default("VALID") // VALID, EXPIRED, REVOKED, NOT_CONFIGURED
  connectionStatus    String    @default("CONNECTED") // CONNECTED, FAILED, DISCONNECTED
  syncFrequency       String    @default("DAILY") // HOURLY, DAILY, MANUAL
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model MetaCampaign {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id])
  clientId            String
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metaCampaignId      String?
  name                String
  status              String              @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  objective           String              @default("LEADS") // LEADS, CONVERSIONS, TRAFFIC, ENGAGEMENT, MESSAGES
  dailyBudget         Float               @default(0)
  lifetimeBudget      Float?
  amountSpent         Float               @default(0)
  impressions         Int                 @default(0)
  reach               Int                 @default(0)
  clicks              Int                 @default(0)
  ctr                 Float               @default(0)
  cpc                 Float               @default(0)
  cpm                 Float               @default(0)
  leads               Int                 @default(0)
  messages            Int                 @default(0)
  conversions         Int                 @default(0)
  costPerResult       Float               @default(0)
  roas                Float               @default(0)
  startDate           DateTime?
  endDate             DateTime?
  assignedMarketerId  String?
  assignedMarketer    Employee?           @relation("AssignedMetaCampaigns", fields: [assignedMarketerId], references: [id])
  creativeUrl         String?
  creativeType        String?             // IMAGE, VIDEO, CAROUSEL
  notes               String?             @db.Text
  dailyInsights       MetaDailyInsight[]
  metaLeads           MetaLead[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model MetaDailyInsight {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    MetaCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime
  spend       Float         @default(0)
  leads       Int           @default(0)
  impressions Int           @default(0)
  clicks      Int           @default(0)
  cpl         Float         @default(0)
  roas        Float         @default(0)
  createdAt   DateTime      @default(now())
}

model MetaLead {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])
  clientId            String
  client              Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignId          String?
  campaign            MetaCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  metaLeadId          String?        // Meta API leadgen_id
  formId              String?
  formName            String?
  adSetId             String?
  adSetName           String?
  adId                String?
  adName              String?
  leadSource          String         @default("Facebook") // Facebook, Instagram
  name                String
  phone               String?
  email               String?
  location            String?        // City / Region
  ageGroup            String?        // 18-24, 25-34, 35-44, 45-54, 55+
  gender              String?        // Male, Female, Other
  leadStatus          String         @default("NEW_LEAD") // NEW_LEAD, CONTACTED, INTERESTED, FOLLOW_UP, CONVERTED, NOT_INTERESTED, WRONG_NUMBER, CLOSED
  qualificationStatus String         @default("QUALIFIED") // QUALIFIED, UNQUALIFIED, DUPLICATE, INVALID
  assignedToId        String?
  assignedTo          Employee?      @relation("AssignedMetaLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContactDate     DateTime?
  nextFollowUpDate    DateTime?
  conversionDate      DateTime?
  conversionValue     Float?         @default(0)
  notes               String?        @db.Text
  leadSubmittedAt     DateTime       @default(now())
  leadNotes           MetaLeadNote[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([companyId, clientId])
  @@index([campaignId])
}

model MetaLeadNote {
  id          String    @id @default(cuid())
  leadId      String
  lead        MetaLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorName  String
  content     String    @db.Text
  createdAt   DateTime  @default(now())
}

model BiometricDeviceCommand {
  id                 Int       @id @default(autoincrement())
  deviceSerialNumber String
  employeeId         String?
  commandType        String
  commandPayload     String    @db.Text
  processingStatus   String    @default("QUEUED")
  responsePayload    String?   @db.Text
  errorMessage       String?   @db.Text
  sentAt             DateTime?
  acknowledgedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model BiometricTemplateArchive {
  id                 Int       @id @default(autoincrement())
  deviceSerialNumber String
  employeeId         String?
  biometricId        String?
  templateType       String
  fingerIndex        Int?
  sourceTable        String
  templateData       String    @db.Text
  rawPayload         String    @db.LongText
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
